UNINEST_DB_URL=jdbc:mysql://mysql:3306/uninest_db?serverTimezone=UTC&connectTimeout=5000&socketTimeout=10000
UNINEST_DB_USER=uninest
UNINEST_DB_PASSWORD=replace-in-host-secret-settings
UNINEST_UPLOAD_DIR=/data/uploads
UNINEST_PUBLIC_URL=https://your-domain.example/uninest
UNINEST_EMAIL_FROM=UniNest <noreply@your-verified-domain.example>
UNINEST_RESEND_API_KEY=configure-in-host-secret-settings
UNINEST_DEMO_PAYMENTS=false
# Public browser key: restrict to Maps Embed API and your exact website origins.
UNINEST_GOOGLE_MAPS_EMBED_KEY=
